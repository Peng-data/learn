#字符串相关的工具模块


def str_reverse(s):
    """
    反转字符串
    :param s: 将被反转的字符串
    :return: 反转后的字符串
    """
    return s[::-1]


def substr(s,x,y):
    """
    功能是按照给定的下标完成字符串的切片
    :param s: 被切片的字符串
    :param x: 切片的起始下标
    :param y: 切片的结束下标
    :return: 切片后的字符串
    """
    return s[x:y:1]

if __name__ == "__main__":
    print(str_reverse("hello"))
    print(substr("hello", 1, 4))