           "林俊杰":{"部门":"技术部",
                     "工资":10000,
                     "级别":3},
           "卢广仲":{"部门":"人事部",
                     "工资":7000,
                     "级别":1}
           }

print(f"升职加薪之前的薪资情况:{message}")
for name in message:
    if message[name]["级别"] == 1:
        employee = message[name]
